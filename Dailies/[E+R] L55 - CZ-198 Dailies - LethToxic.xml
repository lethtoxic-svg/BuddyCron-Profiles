	<CodeChunks>
		<!-- Project DS-5 can't be hurt while a Tentacle is up, and killing one Tentacle kills both.
		     While the DS-5 fight runs, this targets the nearest live Tentacle if the bot is on anything else. -->
		<CodeChunk Name="TentacleFirst" Type="Hook"><![CDATA[
			BuddyCron.Objects.HeroCharacter best = null;
			foreach (var c in BuddyCron.Managers.HeroObjectManager.GetObjects<BuddyCron.Objects.HeroCharacter>())
			{
				if (c == null || c.IsDead || c.Name != "Tentacle") continue;
				if (best == null || c.Distance < best.Distance) best = c;
			}
			if (best == null) return false;
			var cur = BuddyCron.Core.Target;
			if (cur != null && !cur.IsDead && cur.Name == "Tentacle") return false;
			best.SetTarget();
			return false;
		]]></CodeChunk>
	</CodeChunks>

