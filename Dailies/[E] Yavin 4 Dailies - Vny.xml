		<CodeChunk Name="TakeWeekly_B4EA8D_1" Type="Hook"><![CDATA[
			ulong id = 0xE00029D46BB4EA8DUL;
			var spot = new System.Numerics.Vector3(344.964f, 40.15f, 14.503f);
			var me = BuddyCron.Core.Player;
			if (System.Linq.Enumerable.Contains(BuddyCron.Core.Me.Quests.ActiveQuestIds, id)) return false;
			if (me.MissionBoardOpen) { BuddyCron.Objects.HeroGuiApiGfx.Instance.AcceptMission(id); return false; }
			if ((System.DateTime.Now - _TakeWeekly_B4EA8D_1_click).TotalSeconds < 3) return false;
			BuddyCron.Objects.HeroObject best = null; bool bestMarked = false;
			foreach (var o in BuddyCron.Managers.HeroObjectManager.GetObjects<BuddyCron.Objects.HeroObject>())
			{
			    if (o == null || !o.IsValid || o.Name != "Mission Terminal" || System.Numerics.Vector3.DistanceSquared(o.Location, spot) > 9f) continue;
			    bool marked = o.QuestIndication.ToString() != "None";
			    if (best == null || (marked && !bestMarked) || (marked == bestMarked && System.Numerics.Vector3.DistanceSquared(o.Location, spot) < System.Numerics.Vector3.DistanceSquared(best.Location, spot))) { best = o; bestMarked = marked; }
			}
			if (best != null && best.IsWithinInteractRange) { best.Interact(); _TakeWeekly_B4EA8D_1_click = System.DateTime.Now; }
			return false;
		]]></CodeChunk>
